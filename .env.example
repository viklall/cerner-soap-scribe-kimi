# Option 1: Cloudflare Worker (recommended - no API token needed)
# Deploy the worker in cloudflare-worker/ then set the URL:
TRANSCRIPTION_URL=https://whisper-transcriber.YOUR_SUBDOMAIN.workers.dev

# Option 2: Cloudflare REST API (free tier)
# Get these from dash.cloudflare.com:
CLOUDFLARE_ACCOUNT_ID=6fdbd8c973486ac68e99d8bc9db75e1c
CLOUDFLARE_API_TOKEN=your_api_token

# Option 3: OpenAI Whisper (paid, ~$0.006/min)
OPENAI_API_KEY=sk-your-key-here

# Option 4: AWS HealthScribe (enterprise)
AWS_ACCESS_KEY_ID=your_access_key
AWS_SECRET_ACCESS_KEY=your_secret_key
AWS_REGION=us-east-1
AWS_S3_BUCKET=your-scribe-bucket
AWS_ROLE_ARN=arn:aws:iam::YOUR_ACCOUNT:role/HealthScribeRole

# Cerner SMART-on-FHIR (pre-registered, do not change)
CERNER_CLIENT_ID=c52afd29-60bd-4ddf-800f-b175bd91be59
CERNER_TENANT_ID=ec2458f2-1e24-41c8-b71b-0e701af7583d
CERNER_REDIRECT_URI=http://localhost:8080/callback

# Server
PORT=8080

# Set to "true" to skip real Cerner OAuth (dev/demo mode)
CERNER_MOCK_MODE=false
