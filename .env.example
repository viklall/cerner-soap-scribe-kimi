# Required for AWS HealthScribe pipeline
AWS_ACCESS_KEY_ID=your_access_key
AWS_SECRET_ACCESS_KEY=your_secret_key
AWS_REGION=us-east-1
AWS_S3_BUCKET=your-scribe-bucket
AWS_ROLE_ARN=arn:aws:iam::YOUR_ACCOUNT:role/HealthScribeRole

# Required for OpenAI Whisper fallback
OPENAI_API_KEY=sk-your-key

# Required for local Kimi-Audio transcription service
# Set this to the URL of the running Kimi-Audio service
KIMI_TRANSCRIPTION_URL=http://localhost:8000

# Required for Cerner SMART-on-FHIR
CERNER_CLIENT_ID=c52afd29-60bd-4ddf-800f-b175bd91be59
CERNER_TENANT_ID=ec2458f2-1e24-41c8-b71b-0e701af7583d
CERNER_REDIRECT_URI=http://localhost:8080/callback

# Server
PORT=8080

# Set to "true" to skip real Cerner OAuth (dev mode)
CERNER_MOCK_MODE=false
