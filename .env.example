# Cloudflare Workers AI Whisper (FREE - recommended)
# 1. Sign up free at https://dash.cloudflare.com
# 2. Go to Workers & Pages → Create application → Workers AI
# 3. Get Account ID from the right sidebar
# 4. Create API token: My Profile → API Tokens → Create Token → Use Workers AI template
CLOUDFLARE_ACCOUNT_ID=your_account_id
CLOUDFLARE_API_TOKEN=your_api_token

# OpenAI Whisper API (paid, ~$0.006/min)
# Get key at: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-your-key-here

# AWS HealthScribe (enterprise option)
AWS_ACCESS_KEY_ID=your_access_key
AWS_SECRET_ACCESS_KEY=your_secret_key
AWS_REGION=us-east-1
AWS_S3_BUCKET=your-scribe-bucket
AWS_ROLE_ARN=arn:aws:iam::YOUR_ACCOUNT:role/HealthScribeRole

# Cerner SMART-on-FHIR (pre-registered, do not change)
CERNER_CLIENT_ID=c52afd29-60bd-4ddf-800f-b175bd91be59
CERNER_TENANT_ID=ec2458f2-1e24-41c8-b71b-0e701af7583d
CERNER_REDIRECT_URI=http://localhost:8080/callback

# Server
PORT=8080

# Set to "true" to skip real Cerner OAuth (dev/demo mode)
CERNER_MOCK_MODE=false
